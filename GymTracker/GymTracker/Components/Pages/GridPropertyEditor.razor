@page "/gridpropertyeditor"

@using System.Net.Http.Json
@using GymTrackerBusinessService.Generic
@using GymTrackerDataModel.Models
@using System.Linq.Expressions;
@using System.Reflection;
@using System.ComponentModel;
@using System.ComponentModel.DataAnnotations;
@using GymTrackerHelpers
@using System.Collections;
@using GymTracker.Models;
@inject IServiceProvider ServiceProvider
@typeparam TGridEntity

@if (!isDetail)
{
    var isReadonly = prop.GetCustomAttribute<ReadOnlyAttribute>() != null;
    @if (isNavigation)
    {
        var fkProp = ReflectionHelper.GetForeignKeyGrid<TGridEntity>(prop);
        _value = FormatGridValue(Item, fkProp) is int i ? i : 0;
        <MudAutocomplete T="int"
                         ValueChanged="@(v => SetNewDropDownValue(fkProp, v,Item))"
                         Value="(int)_value"
                         Label="@ReflectionHelper.GetDisplayName(Item,prop)"
                         Variant="Variant.Outlined"
                         FullWidth="true"
                         Margin="Margin.Dense"
                         SearchFunc="@( (value, token) => SearchNavData(prop, value, ServiceProvider,token) )"
                         ToStringFunc="@(id => GetDisplayText(prop.Name, id))"
                         Clearable="true"
                         MinCharacters="0"
                         OpenOnFocus="true"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         ReadOnly="isReadonly" />
    }
    else if (prop.PropertyType == typeof(string) && !isNavigation)
    {
        _value = FormatGridValue(Item, prop) is string i ? i : "" ;
        <MudTextField T="string"
                      Value="_value.ToString()"
                      ValueChanged="@(v => SetGridValue(prop, v,Item))"
                      For="@( (Expression<Func<string>>)ReflectionHelper.GetExpression(prop, Item!) )"
                      Label="@ReflectionHelper.GetDisplayName(Item,prop)"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Margin="Margin.Dense"
                      ReadOnly="isReadonly"
                      Style="@GeneralHelpers.GetWidth(_value?.ToString())" 
                      Lines="2"/>
    }
    else if (prop.PropertyType == typeof(int) && !isNavigation)
    {
        _value = FormatGridValue(Item, prop) is int i ? i : 0;
        <MudNumericField T="int"
                         Value="(int)_value"
                         ValueChanged="@(v => SetGridValue(prop, v,Item))"
                         For="@((Expression<Func<int>>)ReflectionHelper.GetExpression(prop, Item!) )"
                         Label="@ReflectionHelper.GetDisplayName(Item,prop)"
                         Variant="Variant.Outlined"
                         FullWidth="true"
                         Margin="Margin.Dense"
                         ReadOnly="isReadonly" />
    }

}

@code {
    private object? _value { get; set; }
    [Parameter]
    public bool isDetail { get; set; } = true;
    [Parameter]
    public bool isNavigation { get; set; } = true;
    [Parameter]
    public TGridEntity? Item { get; set; }
    [Parameter]
    public PropertyInfo? prop { get; set; }
    [Parameter]
    public Func<object, PropertyInfo, object>? FormatGridValue { get; set; }
    [Parameter]
    public Func<PropertyInfo, object, TGridEntity, Task>? SetNewDropDownValue { get; set; }
    [Parameter]
    public Func<PropertyInfo, string, IServiceProvider, CancellationToken, Task<IEnumerable<int>>>? SearchNavData { get; set; }
    [Parameter]
    public Func<string, int, string>? GetDisplayText { get; set; }
    [Parameter]
    public Action<PropertyInfo ,object,object>? SetGridValue { get; set; }  


}
