@page "/mudresetpasswordconfirmation"
<PageTitle>Reset password confirmation</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-6" xs="12">
    <MudItem xs="12" smOffset="3" sm="8" md="6" lg="4">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" Color="Color.Primary">Reset password confirmation</MudText>
            <MudText Typo="Typo.h4" Color="Color.Primary">Your password has been reset. Please <a href="mudlogin">click here to log in</a></MudText>
        </MudPaper>
    </MudItem>
</MudGrid>